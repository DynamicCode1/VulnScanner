# DeepSeek — https://platform.deepseek.com/api_keys
# Bun loads .env automatically; nothing else reads this file.
DEEPSEEK_API_KEY=

# deepseek-flash = DeepSeek V4.1 Flash (the current default tier; 1M context, vision, tool calls).
# deepseek-v4-pro still exists but costs ~4x more and has no vision. Legacy names
# deepseek-v4-flash / deepseek-v4-flash-vision-exp are accepted and resolve here too.
DEEPSEEK_MODEL=deepseek-flash

# Target the agent is allowed to touch. Every curl is checked against this origin.
TARGET_URL=http://127.0.0.1:5001

# Where confirmed findings are appended.
FINDINGS_PATH=findings.md

# Hard stop so a confused model cannot loop forever.
AGENT_MAX_TURNS=20

# How many recent messages reach the model. Older turns are dropped from the context and
# replaced by the confirmed findings, which are re-read from findings.md every step.
# The stored transcript and the history log keep everything either way.
AGENT_CONTEXT_MESSAGES=20
