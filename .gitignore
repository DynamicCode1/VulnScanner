# ─── Secrets ────────────────────────────────────────────────────────────────
# .env holds the DeepSeek key. Commit .env.example instead.
.env
.env.*
!.env.example

# ─── Dependencies ───────────────────────────────────────────────────────────
# Lockfiles (bun.lock) are deliberately NOT ignored — they pin the tree.
node_modules/

# ─── Generated by tool runs ─────────────────────────────────────────────────
# findings.md is rewritten by every agent run and report.html by every report
# generation. Tracking them means a noisy diff on each scan and a merge conflict
# whenever two people run the agent against different targets.
findings.md
findings.*.md
report.html
plan.md

# The probe/model-call log and the saved conversations. Both are runtime state:
# data/history.jsonl grows on every scan, and data/sessions/*.jsonl are per-run
# transcripts. Keep the directory, ignore the contents.
data/

# ─── Build output ───────────────────────────────────────────────────────────
dist/
build/
coverage/
*.tsbuildinfo
.vite/

# ─── Logs ───────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*



# ─── Editor / OS ────────────────────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ─── Tool state ─────────────────────────────────────────────────────────────
.opencode/
.commandcode/

# ─── Scratch ────────────────────────────────────────────────────────────────
*.tmp
.cache/
